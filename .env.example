# En Vercel estas variables las añaden solas las integraciones (Neon/Supabase y Blob).
# En local son opcionales: sin ellas se usa una base de datos embebida y el disco, en .data/
# Para usar en local los servicios reales: `vercel env pull` (crea .env.local).

# Cadena de conexión de PostgreSQL (la "pooled" si el proveedor ofrece dos). También vale POSTGRES_URL.
DATABASE_URL=

# Vercel Blob (store privado). Con BLOB_STORE_ID basta en Vercel; fuera de Vercel, el token.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
